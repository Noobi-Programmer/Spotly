# ==============================================================================
# Spotly Environment Configuration
# ==============================================================================

# Supabase Project URL & Anonymous Key (Obtain from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Host URL for OAuth Callbacks (defaults to window.location.origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
